{
  "name": "smart-portal-functions",
  "version": "1.0.48",
  "description": "Firebase Functions for Smart Portal Admin",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "eslint --ext .ts src/",
    "lint:fix": "eslint --ext .ts src/ --fix",
    "seed": "npx ts-node scripts/seed-firestore.ts",
    "seed:extended": "npx ts-node scripts/seed-firestore-extended.ts",
    "seed:all": "npm run seed && npm run seed:extended"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "date-fns": "^3.0.0",
    "express": "^4.18.2",
    "firebase-admin": "^13.8.0",
    "firebase-functions": "^7.2.5",
    "resend": "^6.9.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.0",
    "firebase-functions-test": "^3.2.0",
    "typescript": "^5.4.0"
  },
  "private": true
}
